{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pangolin",
  "version": "0.1.0-beta.2",
  "identifier": "studio.kelvinsinferno.pangolin",
  "build": {
    "frontendDist": "dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build:ui"
  },
  "app": {
    "windows": [
      {
        "title": "Pangolin",
        "width": 1024,
        "height": 720,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Pangolin password manager (closed-beta, Base Sepolia testnet)",
    "longDescription": "Pangolin — closed-beta desktop password manager. Pre-D-011 audit, testnet only. Do not store production secrets.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
